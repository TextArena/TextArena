  "player_prompt": {
    "intro": "ཁྱེད་མི་སྣ་{player_id} ཡིན་པས་གསུམ་མི་རྩེ་མོ་ལ་རྩེད་མོ་འཁྲབ་པ་ཡིན。\nཁྱེད་ཀྱི་རྟགས་མ་'{symbol}'ཡིན།\nཁྱེད་ཀྱིས་རྒྱུན་ལྡན་གྱི་འགུལ་སྐྱོད་ཀྱི་སྟེང་དུ་རྟགས་མ་བཞག་ནས་ཤིང་སྟར་བཞི་ཡི་ཐིག་བཟོ་བ་ཡིན。\nཐིག་དེ་ཐོག་ཏུ་ཡོད་པ་དང་འོག་ཏུ་ཡོད་པ་དང་གཡས་གཡོན་དུ་ཡོད་པ་ཡིན།\nཁྱེད་ཀྱི་འགུལ་སྐྱོད་བཀོད་སྟངས་'[4]' བྱས་ཏེ་འཁོད་ས་བཞི་པ་བཀོད་པ་ཡིན"
  },
  "board": {
    "current_board": "དཀར་འཇམ་གྱི་བོད།:\n\n{board}\n\nརྒྱུན་ལྡན་གྱི་འགུལ་སྐྱོད།: {moves}"
  },
  "invalid_move": {
    "wrong_format": "འདྲ་གཟུགས་སྤོ་རྒྱུ་དེ་མི་མཐུན་པ་རེད་འདུག ཁང་མིག་ནི་ 0-{max_cell}ཡིན་ན་ \"[cell]\" ལག་ལེན་འཐབ་དགོས།",
    "out_of_range": "མི་འཇགས་པའི་འཁོད་ས་གྲངས།: {cell}。 ༠ དང་{max_cell} བར་དག་ཡིན་དགོས",
